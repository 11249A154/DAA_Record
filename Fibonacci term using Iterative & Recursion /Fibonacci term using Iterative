Aim:

To write a C program that generates the Fibonacci series up to n terms using an iterative approach and displays the nth Fibonacci number.

program:
#include <stdio.h>

int main()
{
    int n;              // Number of terms to be generated
    int a = 0, b = 1, c; // First two Fibonacci numbers and variable for next term

    // Prompt the user to enter number of terms
    printf("Enter the number of terms (n): ");

    // Validate input (must be a non-negative integer)
    if (scanf("%d", &n) != 1 || n < 0)
    {
        printf("Invalid input. Please enter a positive integer.\n");
        return 0;
    }

    // Print heading
    printf("Fibonacci Series: ");

    // Print first term if n >= 1
    if (n >= 1)
        printf("%d ", a);

    // Print second term if n >= 2
    if (n >= 2)
        printf("%d ", b);

    // Calculate remaining terms from 3rd term onwards
    for (int i = 3; i <= n; i++)
    {
        c = a + b;      // Next term is sum of previous two terms
        printf("%d ", c);

        // Update values for next iteration
        a = b;
        b = c;
    }

    /*
     * Logic to display the nth Fibonacci term:
     * If n = 1 → nth term is 'a' (0)
     * If n >= 2 → nth term is 'b'
     */
    if (n == 1)
        printf("\nFibonacci term %d = %d\n", n, a);
    else
        printf("\nFibonacci term %d = %d\n", n, b);

    return 0;
}
