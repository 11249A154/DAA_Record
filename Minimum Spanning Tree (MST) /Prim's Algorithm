Aim:

     To write a C program that implements Prim’s Algorithm to find the Minimum Spanning Tree (MST) of a weighted graph represented using an adjacency matrix, and to calculate
the total minimum cost of connecting all vertices.

program:
#include <stdio.h>
#include <stdlib.h>

#define V 5  // Number of vertices in the graph

/*
 * Function: minKey
 * ----------------
 * Finds the vertex with the minimum key value
 * that is not yet included in MST.
 *
 * key[]     : Stores minimum edge weight for each vertex
 * visited[] : Tracks vertices already included in MST
 *
 * Returns: Index of vertex with minimum key value
 */
int minKey(int key[], int visited[])
{
    int min = 999999;   // Initialize minimum value to a large number
    int min_index = 0;  // Default index

    for (int i = 0; i < V; i++)
    {
        // Select the smallest key among unvisited vertices
        if (!visited[i] && key[i] < min)
        {
            min = key[i];
            min_index = i;
        }
    }
    return min_index;
}

/*
 * Function: printPrimMST
 * ----------------------
 * Prints the edges in the MST and total cost.
 *
 * parent[] : Stores MST structure (parent of each vertex)
 * graph[][]: Adjacency matrix representing graph
 */
void printPrimMST(int parent[], int graph[V][V])
{
    printf("\nPrim's MST:\n");
    printf("Edge \tWeight\n");

    int total = 0;

    // Start from vertex 1 since 0 is root
    for (int i = 1; i < V; i++)
    {
        printf("%d - %d \t%d\n", parent[i], i, graph[i][parent[i]]);
        total += graph[i][parent[i]]; // Add edge weight
    }

    printf("Total Cost = %d\n", total);
}

/*
 * Function: primMST
 * -----------------
 * Implements Prim’s Algorithm to construct MST.
 *
 * graph[][] : Adjacency matrix of the graph
 */
void primMST(int graph[V][V])
{
    int parent[V];   // Stores MST
    int key[V];      // Stores minimum edge weight
    int visited[V];  // Tracks visited vertices

    // Step 1: Initialize all keys as infinite and visited as false
    for (int i = 0; i < V; i++)
    {
        key[i] = 999999; // Infinite value
        visited[i] = 0;  // Not visited
    }

    // Step 2: Start from vertex 0
    key[0] = 0;     // First vertex has 0 cost
    parent[0] = -1; // Root node (no parent)

    // Step 3: Construct MST with V-1 edges
    for (int count = 0; count < V - 1; count++)
    {
        // Pick the vertex with minimum key value
        int u = minKey(key, visited);

        // Mark the selected vertex as visited
        visited[u] = 1;

        // Update key and parent for adjacent vertices
        for (int v = 0; v < V; v++)
        {
            /*
             * Conditions:
             * 1. There is an edge between u and v (graph[u][v] != 0)
             * 2. v is not yet included in MST
             * 3. Weight of edge (u,v) is smaller than current key[v]
             */
            if (graph[u][v] && !visited[v] && graph[u][v] < key[v])
            {
                parent[v] = u;        // Update parent
                key[v] = graph[u][v]; // Update minimum weight
            }
        }
    }

    // Print the resulting MST
    printPrimMST(parent, graph);
}

int main()
{
    /*
     * Graph representation using adjacency matrix
     * 0 indicates no direct edge between vertices
     */
    int graph[V][V] = {
        {0, 2, 3, 0, 0},
        {2, 0, 5, 3, 0},
        {3, 5, 0, 0, 4},
        {0, 3, 0, 0, 2},
        {0, 0, 4, 2, 0}
    };

    // Call Prim’s Algorithm
    primMST(graph);

    return 0;
}
